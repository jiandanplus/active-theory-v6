# Copy to .deployment/production.env (mode 600); never commit real values.
# Set SITE_IMAGE to the exact tag in the delivered release.json.
SITE_IMAGE=
SITE_PLATFORM=linux/amd64
SITE_PORT=3302
SITE_ORIGIN=https://your-owned-domain.example
# Generate each of these independently, using 32 random bytes encoded as hex.
# Hex is URL-safe for the application database connection string.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
SITE_MASTER_KEY=
SETUP_TOKEN=
# Empty trusts no proxy. Inspect the real proxy peer before filling this in.
# Never use true, 0.0.0.0/0, or an unnecessarily broad private network range.
TRUST_PROXY=
S3_ENDPOINT_ALLOWLIST=
